general {
        colors = true
        interval = 5
        output_format = "i3bar"
}

order += "wireless _first_"
order += "ethernet enp12s0"
order += "battery all"
order += "disk /"
order += "disk /data"
order += "cpu_usage"
order += "cpu_temperature 0"
order += "memory"
order += "tztime local"

wireless _first_ {
        format_up = "W: %signal"
        format_down = "W: down"
}

ethernet enp12s0 {
        format_up = "E: %speed"
        format_down = "E: down"
}


battery all {
        format = "%status %percentage %remaining"
        integer_battery_capacity = true
}

disk "/" {
        format = "/: %avail"
}

disk "/data" {
        format = "/data: %avail"
}

cpu_usage {
        format = "CPU %usage"
}

cpu_temperature 0 {
        format = "%degrees°C"
}

memory {
        format = "M: %used"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%a %Y-%m-%d %H:%M:%S"
}
