#!/bin/sh
# 让系统级的浅/深色主题（rofi、GTK 应用如 Firefox）跟随 DMS
# （DankMaterialShell）自己的主题模式，而不是 gammastep 的白天/夜晚时段。
#
# 由 systemd --user 的 dms-theme-sync.path 单元在
# ~/.cache/DankMaterialShell/dms-colors.json 变化时触发（DMS 每次切换
# 主题——包括开启了"按位置自动切换"时——都会由 matugen 重新生成这个
# 文件，其中的 mode 字段是当前浅/深色模式最可靠的来源；
# session.json 的 isLightMode 字段在自动模式下反而会被清空，不可靠）。
#
# 这部分逻辑原来由 gammastep 的 hooks/theme-sync 负责（跟着它自己的
# 白天/夜晚时段走），迁移到 niri+DMS 后 gammastep 不再常驻运行，
# 所以这里改为跟 DMS 自己的判断同步：
#   1) rofi：切换 theme-active.rasi 指向的目标
#   2) GTK 主题：在 Yaru 的浅色/-dark 变体间切换，并写 gtk-3.0/4.0
#      的 settings.ini（DMS 只会同步 color-scheme 这个"偏好"，不会
#      切换实际加载的 GTK 主题包，Firefox 等原生 GTK 应用看的是后者）

set -u

colors_file="$HOME/.cache/DankMaterialShell/dms-colors.json"
state_file="$HOME/.local/state/dms-theme-sync"

[ -f "$colors_file" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

mode=$(jq -r '.mode' "$colors_file" 2>/dev/null)
case "$mode" in
	light|dark) ;;
	*)          exit 0 ;;
esac

mkdir -p "$(dirname "$state_file")"
if [ -f "$state_file" ] && [ "$(cat "$state_file")" = "$mode" ]; then
	exit 0
fi

# 1) rofi 主题
rofi_theme="$HOME/.config/rofi/theme-$mode.rasi"
if [ -f "$rofi_theme" ]; then
	ln -sfn "$rofi_theme" "$HOME/.config/rofi/theme-active.rasi"
fi

# 2) GTK 主题（保留当前强调色变体，如 Yaru-prussiangreen，只切 -dark 后缀）
if command -v gsettings >/dev/null 2>&1; then
	base_theme=Yaru
	current=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
	[ -n "$current" ] && base_theme=${current%-dark}

	if [ "$mode" = dark ]; then
		gtk_theme="${base_theme}-dark"
		[ -d "/usr/share/themes/$gtk_theme" ] || gtk_theme="$base_theme"
		color_scheme=prefer-dark
		prefer_dark=1
	else
		gtk_theme="$base_theme"
		color_scheme=default
		prefer_dark=0
	fi

	gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null
	gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" 2>/dev/null

	# 只更新/插入这两个键，保留 DMS 自己写的 gtk-icon-theme-name 等其他设置
	for d in "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"; do
		mkdir -p "$d"
		f="$d/settings.ini"
		[ -f "$f" ] || printf '[Settings]\n' > "$f"
		if grep -q '^gtk-theme-name=' "$f"; then
			sed -i "s/^gtk-theme-name=.*/gtk-theme-name=$gtk_theme/" "$f"
		else
			sed -i "/^\[Settings\]/a gtk-theme-name=$gtk_theme" "$f"
		fi
		if grep -q '^gtk-application-prefer-dark-theme=' "$f"; then
			sed -i "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$prefer_dark/" "$f"
		else
			sed -i "/^\[Settings\]/a gtk-application-prefer-dark-theme=$prefer_dark" "$f"
		fi
	done
fi

echo "$mode" > "$state_file"
