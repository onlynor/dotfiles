// rofi launcher, bound to $mod+d

// 浅/深色配色。theme-active.rasi 是符号链接，由 gammastep 的
// theme-sync hook 在 daytime/night 切换时重新指向 theme-light.rasi
// 或 theme-dark.rasi（见 ~/.config/gammastep/hooks/theme-sync）。
@import "/home/matthew/.config/rofi/theme-active.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    matching: "normal";
    disable-history: false;
    sort: false;
    cycle: false;
    sidebar-mode: false;
}

* {
    font: "FiraCode Nerd Font Mono 12";
}

window {
    width: 480px;
    border: 2px;
    location: center;
    anchor: center;
}

mainbox {
    padding: 4px;
}

inputbar {
    padding: 4px;
}

entry {
    padding: 2px 6px;
}

listview {
    lines: 12;
    columns: 1;
    dynamic: true;
    scrollbar: false;
}

element {
    padding: 4px 8px;
}

element selected {
}

element-icon {
    size: 24px;
}
