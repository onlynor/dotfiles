# --- OS generated files ---
.DS_Store
Thumbs.db

# --- Generic temporary & backup files ---
*~
*.swp
*.swo
*.bak
*.orig
#*#

# --- Emacs ---
# Package archive (installed via package.el, reproducible from init.el)
emacs/.config/emacs/elpa/
# Native compiled elisp cache (auto-generated, platform-specific)
emacs/.config/emacs/eln-cache/
# Compiled tree-sitter grammars (platform-specific, rebuilt via
# M-x treesit-install-language-grammar)
emacs/.config/emacs/tree-sitter/
# Auto-save list (runtime state)
emacs/.config/emacs/auto-save-list/
# Ido minibuffer history (runtime state, machine-specific paths)
emacs/.config/emacs/ido.last
# url package cache (cookies, cache dir)
emacs/.config/emacs/url/
# Custom-set-variables file (auto-generated, machine-specific)
emacs/.config/emacs/custom.el
# matugen 根据壁纸生成的主题（机器相关，派生文件）
emacs/.config/emacs/themes/


# --- Rofi ---
# system-theme-sync 维护的符号链接（运行时状态，指向 theme-light/dark.rasi）
rofi/.config/rofi/theme-active.rasi

# --- Alacritty ---
# matugen 根据壁纸生成的配色（机器相关，派生文件）
alacritty/.config/alacritty/dank-theme.toml
# dms setup 覆写配置前留的备份
alacritty/.config/alacritty/alacritty.toml.backup.*

# --- Misc ---
# 独立的 git 仓库，不作为本仓库的子模块管理
config-files/

# --- Vim ---
# Netrw directory browsing history
vim/.vim/.netrwhist
# Saved views (auto-generated by mkview)
vim/.vim/view/
# Swap files (crash recovery)
vim/.vim/swap/
# Persistent undo files
vim/.vim/undo/
